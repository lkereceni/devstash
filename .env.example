# Neon PostgreSQL — https://console.neon.tech
#
# Copy this file to `.env` and fill in the values from your Neon project.
# `.env` is gitignored; this file is the documented template.
#
# Each Neon branch has its own pair of connection strings. DATABASE_URL points
# at the DEVELOPMENT branch; production uses a separate Neon branch and sets
# these in the deployment environment, not in a file.

# Pooled connection (host contains "-pooler"). Used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Direct connection (no "-pooler"). Used by `prisma migrate`, which cannot run
# through the connection pooler.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Optional. Only needed if `prisma migrate dev` cannot create its own shadow
# database — point it at a second, empty Neon database.
# SHADOW_DATABASE_URL=""
