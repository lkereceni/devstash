// DevStash schema.
// Starting point built from the data models in context/project-overview.md —
// expected to evolve. Migrations only: `npm run db:migrate`, never `db push`.
//
// The datasource URL is NOT declared here. Prisma 7 reads it from
// prisma.config.ts, and the runtime client gets it through the Neon driver
// adapter in src/lib/prisma.ts.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (NextAuth v5 / Auth.js Prisma adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  // Null for OAuth-only accounts; set for email + password sign-in.
  password      String?

  isPro                Boolean @default(false) @map("is_pro")
  stripeCustomerId     String? @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")

  accounts    Account[]
  sessions    Session[]
  items       Item[]
  itemTypes   ItemType[]
  collections Collection[]
  tags        Tag[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Account {
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  sessionToken String   @id @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

// ---------------------------------------------------------------------------
// Domain
// ---------------------------------------------------------------------------

model Item {
  id          String  @id @default(cuid())
  title       String
  contentType String  @map("content_type") // text | file
  content     String? // used for text types
  fileUrl     String? @map("file_url")
  fileName    String? @map("file_name")
  fileSize    Int?    @map("file_size")
  url         String?
  description String?
  isFavorite  Boolean @default(false) @map("is_favorite")
  isPinned    Boolean @default(false) @map("is_pinned")
  language    String?

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  typeId String   @map("type_id")
  // Deleting a type must not take its items with it.
  type   ItemType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  collectionId String?     @map("collection_id")
  // Uncollecting an item, not deleting it, when its collection goes away.
  collection   Collection? @relation(fields: [collectionId], references: [id], onDelete: SetNull)

  tags ItemTag[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([typeId])
  @@index([collectionId])
  @@index([userId, updatedAt])
  @@index([userId, isPinned])
  @@index([userId, isFavorite])
  @@map("items")
}

model ItemType {
  id       String  @id @default(cuid())
  name     String
  icon     String?
  color    String?
  isSystem Boolean @default(false) @map("is_system")

  // Null for the built-in system types; set for custom (Pro) types.
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items Item[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId])
  @@map("item_types")
}

model Collection {
  id          String  @id @default(cuid())
  name        String
  description String?
  isFavorite  Boolean @default(false) @map("is_favorite")
  color       String?

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items Item[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId])
  @@index([userId, updatedAt])
  @@index([userId, isFavorite])
  @@map("collections")
}

model Tag {
  id   String @id @default(cuid())
  name String

  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items ItemTag[]

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, name])
  @@index([userId])
  @@map("tags")
}

model ItemTag {
  itemId String @map("item_id")
  tagId  String @map("tag_id")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId])
  @@map("item_tags")
}
